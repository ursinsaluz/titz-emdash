---
interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---
<div class={`flex items-center gap-2.5 group ${className}`}>
  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M4 20 L12 4 L20 20 Z"></path>
    <path d="M8 14 L16 14"></path>
  </svg>
  <span class="font-serif text-[17.1px] tracking-[-0.02em] font-medium">
    titz<span class="text-[var(--ember)] italic">.</span>cooking
  </span>
</div>

