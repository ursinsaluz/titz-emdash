---
import BaseLayout from '../layouts/Base.astro';
import TzArrow from '../components/TzArrow.astro';
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import { Image, PortableText } from 'emdash/ui';

// Define interfaces for type safety
interface EmDashEntry {
  id: string;
  data: any;
  edit: any;
  createdAt: string;
}

const { entry: homePage, cacheHint: homeHint } = await getEmDashEntry("pages", "home");
const { entries: dishes, cacheHint: dishesHint } = await getEmDashCollection("dishes");
const { entries: news, cacheHint: newsHint } = await getEmDashCollection("news");
const { entries: offers, cacheHint: offersHint } = await getEmDashCollection("offers");

Astro.cache.set(homeHint);
Astro.cache.set(dishesHint);
Astro.cache.set(newsHint);

// Sort news by date field
const sortedNews = (news as EmDashEntry[]).sort((a, b) => {
  const parseDate = (d: string) => {
    if (!d) return 0;
    const parts = d.split('.');
    if (parts.length === 3) return new Date(`${parts[2]}-${parts[1]}-${parts[0]}`).getTime();
    return new Date(d).getTime() || 0;
  };
  return parseDate(b.data.date) - parseDate(a.data.date) || new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
});
---

<BaseLayout>
  {/* Stage / Hero Section */}
  <section class="relative h-[860px] overflow-hidden bg-[#1a1a18]" id="home">
    <div class="absolute inset-0 z-0">
      <img 
        src="/img/pinot-11.jpg" 
        alt="Sebastian Titz im Restaurant Pinot" 
        class="w-full h-full object-cover opacity-[0.78]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a1a18]/55 via-[#1a1a18]/15 to-[#1a1a18]/75"></div>
    </div>
    
    {/* Hero Text */}
    <div class="absolute left-6 md:left-14 right-6 md:right-14 bottom-20 z-10 text-[var(--paper)]">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] items-end gap-12 lg:gap-12">
        <div>
          <div class="tz-eyebrow text-[var(--paper)]/70 mb-6 flex items-center gap-2">
            <span class="text-[var(--ember)]">●</span>
            KÜCHENCHEF · RESTAURANT PINOT · FLÄSCH
          </div>
          <h1 class="tz-display text-[80px] md:text-[120px] lg:text-[168px] leading-[0.88] font-light -ml-1 lg:-ml-2">
            Authentisch.<br/>
            <span class="italic font-normal">Regional.</span><br/>
            <span class="text-[var(--ember)]">Exzellent.</span>
          </h1>
        </div>
        
        <div class="lg:text-right lg:pb-5">
          <p class="font-serif text-lg md:text-xl italic font-light leading-relaxed max-w-[340px] ml-auto opacity-90 mb-8 lg:mb-7">
            Kulinarik zwischen Michelin-Stern und Bündner Bodenständigkeit.
          </p>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a href="#philosophie" class="tz-btn bg-[var(--ember)] text-[var(--paper)] group">
              Meine Philosophie
              <TzArrow className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href="#kontakt" class="tz-btn bg-transparent border border-[var(--paper)] text-[var(--paper)] hover:bg-[var(--paper)] hover:text-[var(--ink)]">
              Kontakt aufnehmen
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Corner Marks */}
    <div class="absolute top-32 left-6 md:left-14 z-10 font-mono text-[10px] tracking-[0.2em] text-[var(--paper)]/55 uppercase">
      46°59′N · 09°31′E
    </div>
    <div class="absolute top-32 right-6 md:right-14 z-10 font-mono text-[10px] tracking-[0.2em] text-[var(--paper)]/55 text-right uppercase">
      EST. MMXXIV<br/>Nº 001
    </div>
  </section>

  {/* § 01 — Philosophie */}
  <section id="philosophie" class="py-32 md:py-40 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-12 lg:gap-20 mb-20">
        <div>
          <div class="tz-eyebrow mb-4">§ 01 — Philosophie</div>
          <div class="font-mono text-[11px] text-[var(--ink-3)] line-height-[1.7] uppercase tracking-wide">
            Drei Worte, die alles sagen.<br/>
            Drei Prinzipien, die bleiben.
          </div>
        </div>
        <h2 class="tz-display text-4xl md:text-7xl lg:text-[96px] font-light leading-tight max-w-[900px]">
          Kochen ist für mich ein <span class="italic">tiefer Respekt</span> vor dem Ursprung unserer Nahrung.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 border-t border-[var(--rule)] pt-12">
        <div>
          <div class="font-mono text-[10px] tracking-[0.2em] text-[var(--ember)] mb-6 uppercase">§ 01</div>
          <div class="aspect-[4/5] md:h-[300px] bg-[var(--paper-2)] mb-7 overflow-hidden">
            <img src="/img/pinot-07.jpg" alt="Zutaten Vorbereitung" class="w-full h-full object-cover filter saturate-[0.95]" />
          </div>
          <h3 class="tz-display text-4xl mb-3 font-normal">Authentisch</h3>
          <p class="font-serif text-[17px] italic text-[var(--ink-2)] mb-4 leading-snug">Ehrlich und ohne Schnickschnack.</p>
          <p class="text-sm leading-relaxed text-[var(--ink-3)]">Ich koche so, wie ich bin: bodenständig und direkt. Schnörkellose Gerichte, ohne Chichi, aber mit einem echten Wow-Effekt im Mund.</p>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[0.2em] text-[var(--ember)] mb-6 uppercase">§ 02</div>
          <div class="aspect-[4/5] md:h-[300px] bg-[var(--paper-2)] mb-7 overflow-hidden">
            <img src="/img/terroir-1.jpg" alt="Terroir Graubünden" class="w-full h-full object-cover filter saturate-[0.95]" />
          </div>
          <h3 class="tz-display text-4xl mb-3 font-normal">Regional</h3>
          <p class="font-serif text-[17px] italic text-[var(--ink-2)] mb-4 leading-snug">Aus der Heimat auf den Teller.</p>
          <p class="text-sm leading-relaxed text-[var(--ink-3)]">Die besten Lebensmittel finde ich direkt hier. Enge Zusammenarbeit mit lokalen Produzenten — gekocht wird frisch und im Rhythmus der vier Jahreszeiten.</p>
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[0.2em] text-[var(--ember)] mb-6 uppercase">§ 03</div>
          <div class="aspect-[4/5] md:h-[300px] bg-[var(--paper-2)] mb-7 overflow-hidden">
            <img src="/img/dish-2.jpg" alt="Anrichten" class="w-full h-full object-cover filter saturate-[0.95]" />
          </div>
          <h3 class="tz-display text-4xl mb-3 font-normal">Exzellent</h3>
          <p class="font-serif text-[17px] italic text-[var(--ink-2)] mb-4 leading-snug">Die Natur als Massstab.</p>
          <p class="text-sm leading-relaxed text-[var(--ink-3)]">Der Goldene Schnitt. Die Fibonacci-Reihe. Natürliche Ordnung inspiriert mich beim Anrichten — bis daraus mit einem guten Glas Wein ein Erlebnis wird.</p>
        </div>
      </div>
    </div>
  </section>

  {/* § 02 — Der Koch */}
  <section id="koch" class="py-32 md:py-40 px-6 md:px-14 bg-[var(--ink)] text-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">
        <div class="relative h-[400px] md:h-[620px] overflow-hidden">
          <img src="/img/pinot-15.jpg" alt="Sebastian Titz" class="w-full h-full object-cover" />
          <div class="absolute bottom-4 left-4 font-mono text-[9px] tracking-[0.2em] text-[var(--paper)] opacity-70 uppercase">
            FIG. 01 — In der Küche, Restaurant Pinot, Fläsch
          </div>
        </div>
        <div>
          <div class="tz-eyebrow text-[var(--ember)] mb-6">§ 02 — Der Koch</div>
          <h2 class="tz-display text-5xl md:text-7xl font-light leading-none">
            Sebastian <span class="italic text-[var(--ember)]">Titz</span>
          </h2>
          <p class="font-serif italic text-xl md:text-[22px] leading-relaxed mt-7 mb-8 max-w-[520px] opacity-90">
            Zwanzig Jahre Gourmetküche. Ein Michelin-Stern. 16 GaultMillau-Punkte. Und immer noch das Lagerfeuer aus dem Pfadilager im Kopf.
          </p>
          <p class="text-sm md:text-base leading-relaxed max-w-[480px] opacity-75 mb-12">
            Aufgewachsen in Graubünden, geformt in den grössten Küchen der Schweiz, zurückgekehrt in die Bündner Herrschaft. Im Restaurant Pinot kocht Sebastian Titz eine Küche, die das Terroir kennt — und den Gast respektiert.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/stationen" class="tz-btn bg-[var(--ember)] text-[var(--paper)] group">
              Stationen ansehen
              <TzArrow className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href="#philosophie" class="tz-btn bg-transparent border border-[var(--paper)] text-[var(--paper)] hover:bg-[var(--paper)] hover:text-[var(--ink)]">
              Philosophie lesen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* § 03 — Signature Dishes */}
  <section id="dishes" class="py-32 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
        <div>
          <div class="tz-eyebrow mb-4">§ 03 — Signature Dishes</div>
          <h2 class="tz-display text-5xl md:text-[88px] font-light leading-none">
            Die <span class="italic">Sprache</span> des Tellers.
          </h2>
        </div>
        <div class="flex gap-3">
          <button class="w-12 h-12 flex items-center justify-center rounded-sm border border-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--paper)] transition-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          </button>
          <button class="w-12 h-12 flex items-center justify-center rounded-sm bg-[var(--ink)] text-[var(--paper)] hover:bg-[var(--ember)] transition-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {dishes.map((dish, i) => (
          <article class="border-t border-[var(--ink)] pt-4 flex flex-col">
            <div class="flex justify-between items-center mb-4 tz-mono text-[10px] tracking-[0.15em] uppercase text-[var(--ink-3)]">
              <span class={dish.data.category?.toLowerCase() === 'signature' ? 'text-[var(--ember)]' : ''}>
                ● {dish.data.category || 'Signature'}
              </span>
              <span>№ {String(i + 1).padStart(2, '0')}</span>
            </div>
            
            <div class="aspect-[4/5] overflow-hidden bg-[var(--paper-2)] mb-5 group">
              {dish.data.image ? (
                <Image
                  image={dish.data.image}
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-[var(--ink-4)] italic">No image</div>
              )}
            </div>
            
            <h3 class="tz-display text-2xl mb-2 font-medium leading-tight" {...dish.edit.title}>{dish.data.title}</h3>
            <p class="text-sm text-[var(--ink-3)] leading-relaxed mb-4 flex-grow" {...dish.edit.description}>
              {dish.data.description}
            </p>
            <div class="tz-mono text-[10px] tracking-widest text-[var(--ink-4)] uppercase" {...dish.edit.tags}>
              {dish.data.tags}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* § 04 — Aktuelles */}
  <section id="news" class="py-32 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-4xl mx-auto">
      <div class="mb-16">
        <div class="tz-eyebrow mb-4">§ 04 — Aktuelles</div>
        <h2 class="tz-display text-5xl md:text-7xl font-light">Presse & Auszeichnungen</h2>
      </div>
      
      <div class="flex flex-col border-t border-[var(--rule)]">
        {sortedNews.map(item => (
          <a 
            href={item.data.news_source || '#'} 
            target="_blank"
            rel="noopener noreferrer"
            class="py-10 border-b border-[var(--rule-soft)] group block"
          >
            <div class="grid grid-cols-1 md:grid-cols-[120px_1fr_40px] gap-6 items-baseline">
              <div class="tz-mono text-[11px] text-[var(--ink-4)] uppercase pt-1" {...item.edit.date}>
                {item.data.date}
              </div>
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <span class="tz-eyebrow text-[var(--ink-3)]" {...item.edit.tag}>{item.data.tag}</span>
                  <span class="w-1 h-1 rounded-full bg-[var(--rule)]"></span>
                  <span class="tz-eyebrow text-[var(--ink-3)]" {...item.edit.publication}>{item.data.publication}</span>
                </div>
                <h3 class="tz-display text-2xl md:text-3xl mb-4 group-hover:text-[var(--ember)] transition-colors" {...item.edit.title}>{item.data.title}</h3>
                <div class="text-[var(--ink-2)] text-sm leading-relaxed max-w-2xl" {...item.edit.body}>
                  {item.data.body}
                </div>
              </div>
              <div class="flex justify-end opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all">
                <TzArrow className="w-6 h-6 text-[var(--ember)]" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* § 05 — Angebote */}
  <section id="angebote" class="py-32 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <div class="tz-eyebrow mb-4">§ 05 — Angebote</div>
        <h2 class="tz-display text-5xl md:text-[88px] font-light leading-none">
          Drei Wege, <span class="italic">gemeinsam</span> zu kochen.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        {offers.map((offer, i) => (
          <article class="border-t border-[var(--ink)] pt-4">
            <div class="tz-mono text-[10px] tracking-[0.15em] uppercase text-[var(--ink-3)] mb-6 flex justify-between">
               {offer.data.featured ? <span class="text-[var(--ember)]">● Flagship</span> : <span>№ {String(i + 1).padStart(2, '0')}</span>}
            </div>
            <h3 class="tz-display text-3xl mb-6 font-medium" {...offer.edit.title}>{offer.data.title}</h3>
            <p class="text-base text-[var(--ink-2)] font-light mb-4 leading-relaxed" {...offer.edit.lead}>
              {offer.data.lead}
            </p>
            <div class="text-sm text-[var(--ink-3)] mb-8 leading-relaxed opacity-80" {...offer.edit.body}>
               {offer.data.body}
            </div>
            <a href="#kontakt" class="tz-link w-fit group">
              {offer.data.cta_text || 'Anfragen'}
              <TzArrow className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* § 06 — Restaurant & Kontakt */}
  <section id="restaurant" class="py-32 md:py-40 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto" id="kontakt">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-20 lg:gap-24 items-start">
        <div class="lg:col-span-5">
          <div class="tz-eyebrow mb-6">§ 06 — Besuchen Sie uns</div>
          <h2 class="tz-display text-5xl md:text-7xl font-light mb-10 leading-none">Restaurant <span class="italic">Pinot</span>.</h2>
          <p class="text-xl text-[var(--ink-2)] leading-relaxed mb-12 font-light">
            Erleben Sie meine neue Küche — in der Bündner Herrschaft, zwischen Reben und Alpen.
          </p>
          <div class="grid grid-cols-2 gap-10">
            <div>
              <h4 class="tz-eyebrow text-[var(--ink-4)] mb-4">Adresse</h4>
              <div class="tz-mono text-[12px] leading-relaxed text-[var(--ink-3)] uppercase">
                Restaurant Pinot<br/>
                Steigstrasse 14<br/>
                7306 Fläsch
              </div>
            </div>
            <div>
              <h4 class="tz-eyebrow text-[var(--ink-4)] mb-4">Öffnungszeiten</h4>
              <div class="tz-mono text-[12px] leading-relaxed text-[var(--ink-3)] uppercase">
                Täglich 09:00 – 18:00<br/>
                Do Abend ab 18:00
              </div>
            </div>
            <div>
              <h4 class="tz-eyebrow text-[var(--ink-4)] mb-4">Telefon</h4>
              <div class="tz-mono text-[12px] leading-relaxed text-[var(--ink-3)] uppercase">
                +41 79 123 45 67
              </div>
            </div>
            <div>
              <h4 class="tz-eyebrow text-[var(--ink-4)] mb-4">E-Mail</h4>
              <div class="tz-mono text-[12px] leading-relaxed text-[var(--ink-3)] uppercase">
                info@titz.cooking
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 bg-[var(--paper-2)] p-8 md:p-16 rounded-sm border border-[var(--rule-soft)]">
          <form action="/api/contact" method="POST" class="space-y-12" id="contact-form">
            <h4 class="tz-eyebrow text-[var(--ink-4)]">Nachricht senden</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
              <div class="border-b border-[var(--rule)] pb-2 focus-within:border-[var(--ember)] transition-colors">
                <label for="name" class="block tz-mono text-[10px] text-[var(--ink-4)] mb-4">NAME *</label>
                <input type="text" id="name" name="name" required
                  class="w-full bg-transparent focus:outline-none text-[var(--ink)] placeholder-[var(--ink-4)]/50"
                  placeholder="Ihr Name"
                />
              </div>
              <div class="border-b border-[var(--rule)] pb-2 focus-within:border-[var(--ember)] transition-colors">
                <label for="email" class="block tz-mono text-[10px] text-[var(--ink-4)] mb-4">E-MAIL *</label>
                <input type="email" id="email" name="email" required
                  class="w-full bg-transparent focus:outline-none text-[var(--ink)] placeholder-[var(--ink-4)]/50"
                  placeholder="ihre@email.ch"
                />
              </div>
            </div>

            <div class="border-b border-[var(--rule)] pb-2 focus-within:border-[var(--ember)] transition-colors">
              <label for="phone" class="block tz-mono text-[10px] text-[var(--ink-4)] mb-4">TELEFONNUMMER</label>
              <input type="tel" id="phone" name="phone"
                class="w-full bg-transparent focus:outline-none text-[var(--ink)] placeholder-[var(--ink-4)]/50"
                placeholder="+41 00 000 00 00"
              />
            </div>

            <div class="border-b border-[var(--rule)] pb-2 focus-within:border-[var(--ember)] transition-colors">
              <label for="message" class="block tz-mono text-[10px] text-[var(--ink-4)] mb-4">IHRE NACHRICHT... *</label>
              <textarea id="message" name="message" rows="4" required
                class="w-full bg-transparent focus:outline-none text-[var(--ink)] placeholder-[var(--ink-4)]/50 resize-none"
                placeholder="Wie können wir Ihnen helfen?"
              ></textarea>
            </div>

            <!-- Cloudflare Turnstile -->
            <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA'}></div>
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

            <div id="form-message" class="hidden p-4 rounded-sm text-sm"></div>

            <button type="submit" class="tz-btn bg-[var(--ember)] text-[var(--paper)] w-full group">
              Nachricht absenden
              <TzArrow className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const formMessage = document.getElementById('form-message');

    if (form && formMessage) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Wird gesendet...';
        
        formMessage.className = 'hidden p-4 rounded-md mb-6';
        
        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });
          
          const result = await response.json();
          
          if (response.ok) {
            formMessage.textContent = 'Vielen Dank für Ihre Anfrage. Wir melden uns umgehend bei Ihnen zurück.';
            formMessage.className = 'p-4 rounded-md mb-6';
            formMessage.style.cssText = 'background:var(--ember-soft);color:var(--ink);border:1px solid var(--ember)';
            form.reset();
            // Reset Turnstile if it exists globally
            if ((window as any).turnstile) {
              (window as any).turnstile.reset();
            }
          } else {
            throw new Error(result.error || 'Es ist ein Fehler aufgetreten.');
          }
        } catch (error) {
          formMessage.textContent = error instanceof Error ? error.message : 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.';
          formMessage.className = 'p-4 rounded-md mb-6';
          formMessage.style.cssText = 'background:oklch(0.95 0.03 25);color:var(--ink);border:1px solid oklch(0.65 0.12 25)';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
        }
      });
    }
  </script>
</BaseLayout>
