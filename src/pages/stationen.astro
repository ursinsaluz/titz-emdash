---
import BaseLayout from '../layouts/Base.astro';
import TzArrow from '../components/TzArrow.astro';
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import { Image, PortableText } from 'emdash/ui';

const { entry: stationenPage, cacheHint: pageHint } = await getEmDashEntry("pages", "stationen");
const { entries: stations, cacheHint: stationsHint } = await getEmDashCollection("stations");
const { entries: education, cacheHint: educationHint } = await getEmDashCollection("education");
const { entries: qualifications, cacheHint: qualificationsHint } = await getEmDashCollection("qualifications");
const { entries: hobbies, cacheHint: hobbiesHint } = await getEmDashCollection("hobbies");

Astro.cache.set(pageHint);
Astro.cache.set(stationsHint);
Astro.cache.set(educationHint);
Astro.cache.set(qualificationsHint);
Astro.cache.set(hobbiesHint);

const sortByYearDesc = (a, b) => {
  const yearA = parseInt(a.data.year?.match(/\d{4}/)?.[0] || "0");
  const yearB = parseInt(b.data.year?.match(/\d{4}/)?.[0] || "0");
  return yearB - yearA;
};

const sortedStations = stations.sort(sortByYearDesc);
const currentStation = sortedStations.find(s => s.data.current);
const pastStations = sortedStations.filter(s => !s.data.current);
---

<BaseLayout title="Stationen — titz.cooking" navMode="dark">
  {/* Stage / Hero Section */}
  <section class="relative pt-40 pb-24 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <div class="tz-eyebrow mb-4">§ 01 — Vita</div>
        <h1 class="tz-display text-[64px] md:text-[100px] lg:text-[140px] font-light leading-none -ml-1 lg:-ml-2" {...stationenPage?.edit.title}>
          {stationenPage?.data.title ?? "Stationen"}
        </h1>
      </div>
      <div class="font-serif text-xl md:text-3xl text-[var(--ink-2)] italic font-light leading-relaxed max-w-4xl" {...stationenPage?.edit.content}>
        <PortableText value={stationenPage?.data.content ?? []} />
      </div>
    </div>
  </section>

  {/* Current Station */}
  {currentStation && (
    <section class="py-24 px-6 md:px-14 bg-[var(--paper)]">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
          <div class="lg:col-span-5 flex flex-col gap-12">
            <div>
              <div class="flex items-center gap-3 mb-8">
                <span class="w-2 h-2 rounded-full bg-[var(--ember)]"></span>
                <span class="tz-mono text-[var(--ember)] uppercase tracking-widest text-[10px]">Aktuelle Station</span>
              </div>
              <h2 class="tz-display text-5xl md:text-7xl mb-4 font-light" {...currentStation.edit.title}>{currentStation.data.title}</h2>
              <p class="tz-mono text-[var(--ink-3)] text-base tracking-wide uppercase mb-12" {...currentStation.edit.place}>{currentStation.data.place}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-y border-[var(--rule-soft)] py-12">
              <div>
                <span class="tz-mono block text-[var(--ink-4)] text-[10px] tracking-widest mb-4 uppercase">Position</span>
                <span class="text-xl text-[var(--ink)] font-light italic font-serif" {...currentStation.edit.role}>{currentStation.data.role}</span>
              </div>
              {currentStation.data.awards && (
                <div>
                  <span class="tz-mono block text-[var(--ink-4)] text-[10px] tracking-widest mb-4 uppercase">Auszeichnungen</span>
                  <span class="text-[var(--ember)] font-light italic font-serif text-xl" {...currentStation.edit.awards}>{currentStation.data.awards}</span>
                </div>
              )}
            </div>

            <p class="text-[var(--ink-2)] leading-relaxed text-lg font-light max-w-lg" {...currentStation.edit.body}>{currentStation.data.body}</p>
          </div>

          <div class="lg:col-span-7 aspect-[4/5] rounded-sm overflow-hidden bg-[var(--paper-2)]" {...currentStation.edit.image}>
            {currentStation.data.image ? (
              <Image
                image={currentStation.data.image}
                class="w-full h-full object-cover"
                sizes="(min-width: 1024px) 60vw, 100vw"
              />
            ) : (
               <div class="w-full h-full flex items-center justify-center text-[var(--ink-4)] italic">No image</div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Timeline / Werdegang */}
  <section class="py-32 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-24 gap-8">
        <div>
           <div class="tz-eyebrow mb-4">§ 02 — Werdegang</div>
           <h2 class="tz-display text-5xl md:text-8xl font-light">Die <span class="italic">Reise</span> durch die Küchen.</h2>
        </div>
      </div>

      <div class="space-y-32">
        {pastStations.map((station, i) => (
          <div class="group grid grid-cols-1 md:grid-cols-12 gap-12 items-start border-t border-[var(--ink)] pt-12 last:border-b last:pb-32">
            <div class="md:col-span-3">
              <span class="tz-display italic text-4xl md:text-5xl text-[var(--ember)]" {...station.edit.year}>{station.data.year}</span>
              <p class="tz-mono text-[10px] tracking-[0.2em] text-[var(--ink-4)] mt-6 uppercase">№ 0{pastStations.length - i}</p>
            </div>
            <div class="md:col-span-5">
              <h3 class="tz-display text-3xl md:text-5xl mb-6 font-medium" {...station.edit.title}>{station.data.title}</h3>
              <p class="tz-mono text-[var(--ink-3)] text-sm mb-10 uppercase tracking-widest" {...station.edit.place}>{station.data.place}</p>
              
              <div class="mb-10 p-8 bg-[var(--paper-2)] border-l-2 border-[var(--ember)]">
                <span class="tz-mono text-[10px] tracking-widest block mb-3 text-[var(--ink-4)] uppercase">Verantwortung</span>
                <span class="font-light italic font-serif text-2xl text-[var(--ink)]" {...station.edit.role}>{station.data.role}</span>
                {station.data.awards && (
                  <div class="mt-6 pt-6 border-t border-[var(--rule-soft)]">
                     <span class="tz-mono text-[10px] tracking-widest block mb-2 text-[var(--ink-4)] uppercase">Erfolge</span>
                     <span class="text-[var(--ember)] font-medium tz-display text-lg" {...station.edit.awards}>{station.data.awards}</span>
                  </div>
                )}
              </div>
              <p class="text-[var(--ink-2)] leading-relaxed font-light text-base" {...station.edit.body}>{station.data.body}</p>
            </div>
            <div class="md:col-span-4" {...station.edit.image}>
              {station.data.image ? (
                <div class="aspect-[4/5] overflow-hidden rounded-sm bg-[var(--paper-2)]">
                  <Image
                    image={station.data.image}
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000"
                    sizes="(min-width: 768px) 33vw, 100vw"
                  />
                </div>
              ) : (
                <div class="aspect-[4/5] bg-[var(--paper-2)] flex items-center justify-center text-[var(--ink-4)] italic">Impression folgt</div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Education & Qualifications */}
  <section class="py-32 px-6 md:px-14 bg-[var(--ink)] text-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-24">
        <div class="tz-eyebrow text-[var(--ember)] mb-4">§ 03 — Expertise</div>
        <h2 class="tz-display text-5xl md:text-8xl font-light text-white">Ausbildung & <span class="italic text-[var(--ember)]">Schliff</span>.</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 lg:gap-32">
        {/* Education */}
        <div class="flex flex-col gap-16">
          <h3 class="tz-mono text-[var(--paper)]/40 text-[11px] tracking-[0.3em] uppercase border-b border-white/10 pb-6">Fundament</h3>
          <div class="flex flex-col gap-16">
            {education.map(item => (
              <div class="group">
                <span class="tz-display italic text-[var(--ember)] text-3xl mb-4 block" {...item.edit.year}>{item.data.year}</span>
                <h4 class="tz-display text-3xl md:text-4xl mb-3 font-normal" {...item.edit.title}>{item.data.title}</h4>
                <p class="tz-mono text-[var(--paper)]/50 mb-6 text-[12px] tracking-widest uppercase" {...item.edit.place}>{item.data.place}</p>
                <p class="text-base text-[var(--paper)]/70 leading-relaxed font-light" {...item.edit.note}>{item.data.note}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Qualifications */}
        <div class="flex flex-col gap-16">
          <h3 class="tz-mono text-[var(--paper)]/40 text-[11px] tracking-[0.3em] uppercase border-b border-white/10 pb-6">Qualifikationen</h3>
          <div class="flex flex-col gap-12">
            {qualifications.map(item => (
              <div class="group border-b border-white/10 pb-12 last:border-0">
                <div class="flex items-center gap-6 mb-6">
                  <span class="tz-mono text-[10px] bg-white/10 px-3 py-1.5 rounded-sm text-white tracking-[0.15em] uppercase" {...item.edit.kind}>
                    {item.data.kind}
                  </span>
                  {item.data.year && item.data.year !== '—' && (
                    <span class="tz-display italic text-[var(--ember)] text-2xl" {...item.edit.year}>{item.data.year}</span>
                  )}
                </div>
                <h4 class="tz-display text-2xl md:text-3xl mb-4 font-normal group-hover:text-[var(--ember)] transition-colors" {...item.edit.title}>{item.data.title}</h4>
                <p class="text-[var(--paper)]/70 leading-relaxed font-light text-base" {...item.edit.note}>{item.data.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Hobbies / Ausgleich */}
  <section class="py-32 px-6 md:px-14 bg-[var(--paper)]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-24">
        <div class="tz-eyebrow mb-4">§ 04 — Ausgleich</div>
        <h2 class="tz-display text-5xl md:text-8xl font-light">Ruhe & <span class="italic">Inspiration</span>.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {hobbies.map((hobby, i) => (
          <div class="group flex flex-col">
            <div class="aspect-[4/5] overflow-hidden rounded-sm mb-8 bg-[var(--paper-2)]" {...hobby.edit.image}>
              {hobby.data.image ? (
                <Image
                  image={hobby.data.image}
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000"
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center p-8 text-center text-[var(--ink-4)] tz-mono text-[10px] tracking-widest italic border border-dashed border-[var(--ink-4)]">
                  {hobby.data.placeholder || 'MOMENTAUFNAHME'}
                </div>
              )}
            </div>
            <div class="flex justify-between items-baseline mb-4">
               <h3 class="tz-display text-2xl md:text-3xl font-medium" {...hobby.edit.title}>{hobby.data.title}</h3>
               <span class="tz-mono text-[10px] text-[var(--ink-4)]">№ 0{i+1}</span>
            </div>
            <p class="text-[var(--ink-3)] text-sm leading-relaxed font-light" {...hobby.edit.note}>{hobby.data.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
